# Copy to .env and fill in your own values. Never commit .env.

# --- LOCAL DEVELOPMENT ---
# true = in-memory chat memory, no Redis cache (no Cloud SQL / Memorystore needed)
LOCAL_MODE=true
BACKEND_URL=http://localhost:8000

# --- GCP ---
# Vertex AI embeddings use your gcloud login: `gcloud auth application-default login`
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
GCP_DOC_AI_LOCATION=us
GCP_DOC_AI_PROCESSOR_ID=
# PDF parsing: pypdf (free, local) or docai (Document AI OCR, ~$1.50 per 1,000 pages)
PDF_PARSER=pypdf
GCP_RAW_BUCKET=your-project-rag-raw
GCP_PROCESSED_BUCKET=your-project-rag-processed

# --- VECTOR DB (Qdrant Cloud, free tier: https://cloud.qdrant.io) ---
QDRANT_CLUSTER_ENDPOINT=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- LLM (Groq, free tier: https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM GATEWAY ---
# Primary: open model on Vertex AI (GCP credits, no daily cap); empty = start at Groq
VERTEX_MODEL=openai/gpt-oss-120b-maas
VERTEX_MAAS_LOCATION=us-central1
VERTEX_TIMEOUT_S=20
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- CLOUD-ONLY (ignored when LOCAL_MODE=true) ---
DB_USER=rag_admin
DB_PASS=
DB_NAME=rag_memory
DB_CONNECTION_NAME=
REDIS_HOST=
REDIS_PORT=6379

# --- OBSERVABILITY (optional) ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise_rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
